{
  "name": "yansd-image-playground",
  "productName": "Image Atelier",
  "description": "A multi-model image generation gallery for OpenAI and Gemini.",
  "author": "yansd001",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "npm run build:backend && vitest run tests/gallery.test.ts tests/storage.test.ts && go test ./backend",
    "test:backend": "go test ./backend",
    "test:ui": "playwright test",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "go run ./backend -api-only -open-browser=false -data ./data",
    "build:frontend": "tsc -b && vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "npm run build:frontend && node scripts/build-backend.mjs --release",
    "test:package": "npm run build && node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  }
}
